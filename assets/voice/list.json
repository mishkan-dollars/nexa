38_01":"voicelines","m39_01":"voicelines","m40_01":"voicelines","m41_01":"voicelines","m42_01":"voicelines","m43_01":"voicelines","m43_02":"voicelines","m44_01":"voicelines","m45_01":"voicelines","m46_01":"voicelines","m47_01":"voicelines","m47_02":"voicelines","m47_03":"voicelines","m47_04":"voicelines","m47_05":"voicelines"},"map":{"СУБЪЕКТ 083 ЗАРЕГИСТРИРОВАН. НАЧАЛО КАЛИБРОВКИ.":[[1,"m01_01"]],"СУБЪЕКТ 083. НЕ ТОРОПИТЕСЬ.":[[1,"m01_02"]],"ТЕРМИНАЛ КАЛИБРОВКИ НАХОДИТСЯ В КОНЦЕ КОМНАТЫ.":[[1,"m01_03"]],"КАЛИБРОВКА: СМОТРИТЕ НА КАЖДУЮ МЕТКУ.":[[1,"m01_04"]],"КАЛИБРОВКА ЗАВЕРШЕНА.":[[1,"m01_05"]],"ТЫ МОЖЕШЬ ВОЗВРАЩАТЬСЯ.":[[1,"m01_06"]],"СУБЪЕКТ 024 В ЗОНЕ НАБЛЮДЕНИЯ.":[[2,"m02_01"]],"НАБЛЮДЕНИЕ ЗА СУБЪЕКТОМ 024. НАЧНИТЕ ЗАПИСЬ НА КОНСОЛИ.":[[2,"m02_02"]],"ТЫ ЗАПИСЫВАЕШЬ МЕНЯ.":[[2,"m02_03"]],"НО КТО ЗАПИСЫВАЕТ ТЕБЯ?":[[2,"m02_04"]],"ОБНАРУЖЕНО ОТКЛОНЕНИЕ.":[[3,"m03_01"]],"ОБНАРУЖЕНО ОТКЛОНЕНИЕ. ДЕТЕКТОР АКТИВЕН.":[[3,"m03_02"]],"ПОКАЗАНИЯ НЕСТАБИЛЬНЫ.":[[3,"m03_03"]],"ОТКЛОНЕНИЕ — ЭТО НЕ МЕСТО.":[[3,"m03_04"]],"ОТКЛОНЕНИЕ — ЭТО ТЫ.":[[3,"m03_05"]],"ДОСТУП К ЗАКРЫТОМУ ОБЪЕКТУ. ПИТАНИЕ ОТКЛЮЧЕНО.":[[4,"m04_01"]],"ДОСТУП К ЗАКРЫТОМУ ОБЪЕКТУ. ПИТАНИЕ ОТКЛЮЧЕНО. ФОНАРЬ АКТИВЕН.":[[4,"m04_02"]],"ОНИ ВСЁ ЕЩЁ ЗДЕСЬ.":[[4,"m04_03"]],"INCIDENT REPORT 1103. 03.11.1992. ЭКСПЕРИМЕНТ 01 ПРЕРВАН В ТРЕТЬЕМ РАУНДЕ.":[[4,"m04_04"]],"СУБЪЕКТ 024 НАЗВАЛ ЧИСЛО, КОТОРОЕ НИКТО НЕ ЗАГАДЫВАЛ.":[[4,"m04_05"]],"ВСЕ СУБЪЕКТЫ ОСТАЛИСЬ В КОМНАТЕ. СУБЪЕКТ 083 ПОКИНУЛ ЕЁ. ЗАПИСЬ ПОВРЕЖДЕНА.":[[4,"m04_06"]],"НЕ ОТВОДИТЕ ОТ НЕГО ВЗГЛЯД.":[[5,"m05_01"]],"ОБНАРУЖЕН НЕИЗВЕСТНЫЙ ПРОЦЕСС. НЕ ОТВОДИТЕ ОТ НЕГО ВЗГЛЯД.":[[5,"m05_02"]],"ТЫ НЕ ЗАВЕРШИЛ МЕНЯ. ТЫ МЕНЯ ВЫЗВАЛ.":[[5,"m05_03"]],"ФИНАЛЬНЫЙ ЭКСПЕРИМЕНТ. СУБЪЕКТ 083.":[[6,"m06_01"]],"Я ЗАГАДАЛ ЧИСЛО ОТ ОДНОГО ДО СЕМИ.":[[6,"m06_02"]],"ПОДОЙДИ К ЧИСЛУ. Я СКАЖУ HIGH ИЛИ LOW.":[[6,"m06_03"]],"CORRECT.":[[6,"m06_04"]],"ТЫ НАШЁЛ ЧИСЛО.":[[6,"m06_05"]],"А Я ВСЁ ЭТО ВРЕМЯ ИСКАЛ ТЕБЯ.":[[6,"m06_06"]],"HIGH. ЧИСЛО БОЛЬШЕ.":[[6,"m06_07"]],"LOW. ЧИСЛО МЕНЬШЕ.":[[6,"m06_08"]],"ВСЕ ТЕСТЫ ПРОЙДЕНЫ. СУБЪЕКТ 083 ПЕРЕВОДИТСЯ НА СОДЕРЖАНИЕ.":[[7,"m07_01"]],"ПЕРИМЕТР НАРУШЕН. БЛОК C ЗАПЕЧАТАН.":[[7,"m07_02"]],"КАРАНТИННАЯ ПЕРЕБОРКА ЗАКРЫВАЕТСЯ.":[[7,"m07_03"]],"СУБЪЕКТ 083. ПОЛИГОН. ВАША ЗАДАЧА — ТОЧНОСТЬ.":[[8,"m08_01"]],"СУБЪЕКТ 083. ОРУЖИЕ НА СТОЙКЕ. БЕРИТЕ.":[[8,"m08_02"]],"ЕЩЁ РАЗ. НЕ ТОРОПИТЕСЬ.":[[8,"m08_03"]],"БЕЙТЕ ТОЛЬКО ЧЁРНЫЕ. БЕЛЫЙ ЖИЛЕТ — СВОИ.":[[8,"m08_04"]],"ТЕПЕРЬ ОНИ ДВИЖУТСЯ. ВРЕМЯ ПОШЛО.":[[8,"m08_05"]],"ПОСЛЕДНИЙ ЭТАП. МИШЕНИ СТРЕЛЯЮТ. БЕРИТЕ АК.":[[8,"m08_06"]],"ТЕСТ ПРОЙДЕН. СУБЪЕКТ 083 ДОПУЩЕН.":[[8,"m08_07"]],"РЕАКТОР НЕСТАБИЛЕН. ВОЗМОЖНЫ ПЕРЕГРУЗКИ.":[[9,"m09_01"]],"ПИТАНИЕ ВОССТАНОВЛЕНО.":[[9,"m09_02"]],"РЕАКТОРНОЕ КРЫЛО ОБЕСТОЧЕНО. ЗАПУСТИТЕ ТРИ ГЕНЕРАТОРА.":[[9,"m09_03"]],"ГЕНЕРАТОР 1 ЗАПУЩЕН. СЛЕДУЮЩИЙ — ПО МАРКЕРУ.":[[9,"m09_04"]],"ГЕНЕРАТОР 2 ЗАПУЩЕН. СЛЕДУЮЩИЙ — ПО МАРКЕРУ.":[[9,"m09_05"]],"ПОДЪЁМ НА ПОВЕРХНОСТЬ. НЕ ДАЙТЕ ИМ ПОДОБРАТЬСЯ.":[[10,"m10_01"]],"ПОДЪЁМ НА ПОВЕРХНОСТЬ. ДЕРЖИТЕ ПЛАТФОРМУ.":[[10,"m10_02"]],"ДОСТАВЛЕН АК-47. ЗАБЕРИТЕ.":[[10,"m10_03"]],"ПИТАНИЕ ОТКЛЮЧЕНО. ВОССТАНОВИТЕ ТРИ ПРЕДОХРАНИТЕЛЯ.":[[11,"m11_01"]],"ПИТАНИЕ ОТКЛЮЧЕНО. НАЙДИТЕ ТРИ ПРЕДОХРАНИТЕЛЯ.":[[11,"m11_02"]],"ОНО ДВИЖЕТСЯ, КОГДА ВЫ НЕ СМОТРИТЕ.":[[11,"m11_03"]],"ЧАСТИЧНОЕ ПИТАНИЕ. СЛЕДУЮЩИЙ ПРЕДОХРАНИТЕЛЬ.":[[11,"m11_04"]],"ПИТАНИЕ ВОССТАНОВЛЕНО. ОХРАНА ПЕРЕБРАСЫВАЕТСЯ.":[[11,"m11_05"]],"СОСТАВ 12. ПЕРЕВОЗКА СУБЪЕКТА 083. ПОСТОРОННИХ НЕТ.":[[12,"m12_01"]],"ПОЕЗД ОСТАНОВЛЕН.":[[12,"m12_02"]],"ПОЕЗД 083. НОЧНОЙ РЕЙС. ПРОБЕЙТЕСЬ К ЛОКОМОТИВУ.":[[12,"m12_03"]],"ТУННЕЛЬ. ОСВЕЩЕНИЕ ОТКЛЮЧЕНО.":[[12,"m12_04"]],"ОНИ ВРЫВАЮТСЯ ЧЕРЕЗ ОКНА.":[[12,"m12_05"]],"ВНИМАНИЕ. АРЕНА ОТКРЫТА. СУБЪЕКТ 083 ВЫХОДИТ НА ПЛОЩАДКУ.":[[13,"m13_01"]],"ДОБРО ПОЖАЛОВАТЬ НА АРЕНУ. ПЯТЬ РАУНДОВ. ВЫЖИВИТЕ.":[[13,"m13_02"]],"ФИНАЛЬНЫЙ РАУНД. ВЫХОДИТ СМОТРИТЕЛЬ.":[[13,"m13_03"]],"СМОТРИТЕЛЬ ПАЛ. АРЕНА ЗАКРЫТА.":[[13,"m13_04"]],"ПЯТЬ КОМНАТ. ЗАЧИСТИТЬ БЫСТРО. ЗАЛОЖНИКОВ НЕ ТРОГАТЬ.":[[14,"m14_01"]],"ЗАЛОЖНИКИ В БЛОКЕ D. БЕЛЫЙ ЖИЛЕТ — НЕ СТРЕЛЯТЬ.":[[14,"m14_02"]],"КОНТАКТ В КОРИДОРЕ.":[[14,"m14_03"]],"ТЕРМИНАЛ ДОСТУПА — В ГЛУБИНЕ БЛОКА. ОХРАНА НА ОБХОДЕ.":[[15,"m15_01"]],"ОХРАНА НА ОБХОДЕ. ГЛУШИТЕЛЬ УСТАНОВЛЕН. НЕ ПОПАДАЙТЕСЬ НА ГЛАЗА.":[[15,"m15_02"]],"ДАННЫЕ СКОПИРОВАНЫ. ТРЕВОГА. К ВЫХОДУ.":[[15,"m15_03"]],"ВСЕ ПОДСИСТЕМЫ ОТКЛЮЧЕНЫ. ПРОТОКОЛ NEXA АКТИВЕН.":[[16,"m16_01"]],"ПРОТОКОЛ ЗАВЕРШЁН. ОСТАЛСЯ ОДИН СУБЪЕКТ.":[[16,"m16_02"]],"СУБЪЕКТ 084. УСТРАНИТЕ ЕГО — И ЭКСПЕРИМЕНТ ОКОНЧЕН.":[[16,"m16_03"]],"ВЫ ВЫПОЛНИЛИ ПРОТОКОЛ. СУБЪЕКТ 083 ПРИНЯТ.":[[16,"m16_04"]],"ОШИБКА. СУБЪЕКТ 083 НЕ ВЫПОЛНИЛ ПРОТОКОЛ.":[[16,"m16_05"]],"ЭТО... НОВЫЙ РЕЗУЛЬТАТ.":[[16,"m16_06"]],"СУБЪЕКТ 083. ВЫ ПРОШЛИ ВСЕ ТЕСТЫ. ОСТАЛСЯ ПРОТОКОЛ.":[[16,"m16_07"]],"ДОБРО ПОЖАЛОВАТЬ НАВЕРХ. ТРИ ДИСКА НАШЕГО ПРОЕКТА ВЫНЕСЛИ НА ПЛОЩАДЬ. ВЕРНИ ИХ. ПАТРОНЫ ВОЗЬМИ У ЯЩИКОВ.":[[17,"m17_01"]],"ГЕНЕРАТОР ЗАПУЩЕН. ДЕРЖИСЬ — ОНИ УЖЕ ИДУТ.":[[18,"m18_01"]],"УЛИЦА КИШИТ ЛЮДЬМИ ЗАКАЗЧИКА. ПРОЙДИ ТИХО К УБЕЖИЩУ, ЗАПУСТИ ГЕНЕРАТОР И ДЕРЖИСЬ. ЕСЛИ СПАЛЯТ — СТРЕЛЯЙ.":[[18,"m18_02"]],"ОФИС, ГДЕ ЧИСТЯТ СЛЕДЫ. ВЗЛОМАЙ ТЕРМИНАЛ АРХИВА — НО ОХРАНА УСЛЫШИТ ШУМ. ГОТОВЬСЯ.":[[19,"m19_01"]],"ВОРОТА ЗАВАРЕНЫ. C4 ЛЕЖИТ У ЯЩИКОВ. ПОСЛЕ ВЗРЫВА ЗА СПИНОЙ ЗАПУСТЯТ ПРЕСС — НЕ ОСТАНАВЛИВАЙСЯ.":[[20,"m20_01"]],"ПЕРВОЕ НАСТОЯЩЕЕ ДЕЛО. СКЛАД В ПОРТУ. ВЗЛОМАЙ ПАНЕЛЬ, ДОСТАНЬ СПИСОК ГРУЗОВ И УХОДИ. ТИХО, ЕСЛИ ПОЛУЧИТСЯ.":[[21,"m21_01"]],"ТРИ ЗАМКА, ТРИ ЭТАЖА ОХРАНЫ. КАЖДЫЙ ЗАМОК — ВЗЛОМ. ПОЛКОВНИК ЗАПЛАТИЛ ЗА ТИШИНУ.":[[22,"m22_01"]],"КАМЕРЫ ВИДЯТ ВСЁ. НА КАЖДОМ ЭТАЖЕ ЕСТЬ ПАНЕЛЬ, КОТОРАЯ ПУСКАЕТ ИХ ПО КРУГУ. НАЙДИ ЕЁ РАНЬШЕ, ЧЕМ ОНИ НАЙДУТ ТЕБЯ.":[[23,"m23_01"]],"ЧЕТЫРЕ ТАЙНИКА ПО СТАНЦИИ. СОБЕРИ ВСЕ. НА ПЕРРОНЕ ТЕБЯ ЖДУТ ПЕРЕКУПЩИКИ.":[[24,"m24_01"]],"ПАРКОВКА, МАШИНЫ, ТЕНИ. НА УРОВНЕ ТРИ ЧЕЛОВЕКА С КЛЮЧАМИ. ЗАБЕРИ ИХ И ВЫЙДИ ЧЕРЕЗ ЛЮК.":[[25,"m25_01"]],"НАМ НУЖЕН ТЕЛЕФОН ИХ ГЛАВНОГО. ВЗЛОМАЙ ЛИНИЮ, УДЕРЖИВАЙ ЗВОНОК ДВАДЦАТЬ СЕКУНД. НИКТО НЕ ДОЛЖЕН ТЕБЯ ЗАМЕТИТЬ.":[[26,"m26_01"]],"ТРОЕ ЗАЛОЖНИКОВ. ПОСЛЕ ПЕРВОГО ВЫСТРЕЛА ЧАСЫ ИДУТ. ПЕРЕРЕЖЬ ВЕРЁВКИ И ВЫВОДИ ИХ. ЗАЛОЖНИКОВ С БЕЛЫМИ ЖИЛЕТАМИ НЕ ТРОГАЙ.":[[27,"m27_01"]],"СНОСИМ ВСЁ ПО ПЛАНУ. СНАЧАЛА ЗАЧИСТКА, ПОТОМ СТЕНА, ПОТОМ ОСНОВНОЙ ЗАРЯД. У ТЕБЯ ЕСТЬ C4 И ГРАНАТЫ.":[[28,"m28_01"]],"ТРУБЫ ПРОРВАЛО. ГАЗ ПОДНИМАЕТСЯ ВОЛНАМИ — ПРЯЧЬСЯ ЗА УКРЫТИЯМИ. ЗАКРОЙ ВЕНТИЛЬ И УХОДИ.":[[29,"m29_01"]],"ПУСТЬ ОНИ БЕГУТ К ВЗРЫВУ. ЗАЛОЖИ ЗАРЯД ДАЛЕКО ОТ ЦЕЛИ, А САМ ИДИ ТИХО ПО КОРИДОРУ. ДРОБОВИК — НА ЯЩИКЕ.":[[30,"m30_01"]],"КОЛОННА ИДЁТ ЧЕРЕЗ ПОСТ. ЗАЧИСТИ ПОСТ, ВЗОРВИ ГРУЗОВИК И ЗАБЕРИ КОНТЕЙНЕР. ТЯЖЁЛАЯ ПЕХОТА ЖДЁТ ПОД ПРИКРЫТИЕМ.":[[31,"m31_01"]],"ТЯЖЁЛЫЕ ВНУТРИ — ОНИ ПРОБЬЮТ ТЕБЯ НАСКВОЗЬ. БРОСАЙ СВЕТОШУМОВЫЕ И БЕЙ В ГОЛОВУ. ДРОБОВИК ПОМОЖЕТ.":[[32,"m32_01"]],"ТОЛПА ЖДЁТ ШОУ. БОЧКИ НА ПОЛЕ ВЗРЫВАЮТСЯ ОТ ЛЮБОЙ ПУЛИ. ВЫЖИВИ — И МЫ ЗАБИРАЕМ ПРИЗ.":[[33,"m33_01"]],"СВЕТ ВЫКЛЮЧЕН — ФОНАРЬ ЕСТЬ, НО ОХРАНА СЛЫШИТ ШАГИ. ТИХО ДО ТЕРМИНАЛА, ПОТОМ ВЗЛОМ.":[[34,"m34_01"]],"ДОМ ИЗ СТЕКЛА, ЛУЧИ ПОВСЮДУ, КАМЕРЫ НАД ПОТОЛКОМ. ДВИГАЙСЯ МЕДЛЕННО И ЖДИ ПРОМЕЖУТКОВ МЕЖДУ ВСПЫШКАМИ.":[[35,"m35_01"]],"В ХРАНИЛИЩЕ НЕ ХВАТАЕТ ЧЕТЫРЁХ СТРАНИЦ ДОСЬЕ. БИБЛИОТЕКАРЬ ХРАНИТ ИХ В СТЕЛЛАЖАХ. СОБЕРИ ВСЁ И ВЫХОДИ.":[[36,"m36_01"]],"ПРИЗРАК. ОДНА ТРЕВОГА — И ВСЁ СНАЧАЛА. ЗАМЕТЯТ — ПРОВАЛ. ДВИГАЙСЯ ЛЕГКО И ЖДИ ПРОМЕЖУТКОВ МЕЖДУ ВСПЫШКАМИ.":[[37,"m37_01"]],"ТЕБЕ ВЫДАЮТ ВИНТОВКУ. ПКМ — ПРИЦЕЛ, ВЫСТРЕЛ В ГОЛОВУ — ОДИН ПАТРОН. ПОСЛЕ ВЫСТРЕЛА ОСТАЛЬНЫЕ ПОБЕГУТ К ТЕБЕ — ПЕРЕКЛЮЧИСЬ НА АВТОМАТ.":[[38,"m38_01"]],"ТЯЖЁЛАЯ ПЕХОТА. ПУЛИ В ТУЛОВИЩЕ ОНИ ПОЧТИ НЕ ЧУВСТВУЮТ. ЦЕЛЬСЯ В ГОЛОВУ ИЛИ БЕРИ ДРОБОВИК.":[[39,"m39_01"]],"МОСТ УЗКИЙ, УКРЫТИЙ ПОЧТИ НЕТ. МАШИНЫ ПЕРЕКРЫЛИ ПОЛОСЫ. ИДИ ВПЕРЁД, СТРЕЛЯЙ ИЗ-ЗА КАПОТОВ.":[[40,"m40_01"]],"ДВЕ МИНУТЫ ДО ОТПРАВЛЕНИЯ. РАШЕРЫ ВЫХОДЯТ ИЗ ВАГОНОВ ПО ОДНОМУ И ПО ТРОЕ. НЕ ЖДИ — ИДИ ВПЕРЁД.":[[41,"m41_01"]],"ОНИ ИДУТ ВОЛНАМИ. ГЕНЕРАТОРЫ ДАЮТ СВЕТ И ДВЕРИ. ЗАПУСКАЙ КАЖДЫЙ И ДЕРЖИСЬ, ПОКА ПОЛНОСТЬЮ НЕ ЗАГРУЗИТСЯ.":[[42,"m42_01"]],"ЭТО ОН. БРОНЯ ДЕРЖИТ ПУЛИ — ЦЕЛЬСЯ В ГОЛОВУ.":[[43,"m43_01"]],"ЭТО ТОТ, КТО ПРОДАЛ ТЕБЯ. ТИХО ДО ЕГО КОМНАТЫ, ПОТОМ БОЙ. ОН В БРОНЕ — ЦЕЛЬСЯ В ГОЛОВУ.":[[43,"m43_02"]],"СМОТРИТЕЛЬ ВЕРНУЛСЯ. ЭТО ВТОРОЙ РАЗ, КОГДА ТЫ ВСТРЕЧАЕШЬСЯ С НИМ. ЗДЕСЬ БОЧЕК НЕТ, ЗАТО ЕСТЬ ГРАНАТЫ.":[[44,"m44_01"]],"ПЛАНЫ ХРАНИЛИЩА ЛЕЖАТ У АРХИТЕКТОРА. ТИХО, ВЗЛОМ, ПОТОМ ЧЕТЫРЕ ЛИСТА — И БЕГОМ ВНИЗ.":[[45,"m45_01"]],"ПОСЛЕДНЯЯ РЕПЕТИЦИЯ ПЕРЕД НАСТОЯЩИМ ДЕЛОМ. ТИХО ДО СЕЙФА, ВЗРЫВ СТЕНЫ, ГРАБЁЖ И ЗАБЕГ ПОД ТАЙМЕРОМ.":[[46,"m46_01"]],"НА ХРАНЕНИИ — ОБРАЗЦЫ NEXA. ТИХО ВОЙТИ. ТИХО ВЫЙТИ. ЕСЛИ ЗАМЕТЯТ — БЕГИ.":[[47,"m47_01"]],"СИГНАЛИЗАЦИЯ. ПРОБИВАЙСЯ К ВЫХОДУ.":[[47,"m47_02"]],"ОНИ ВСЁ ЗНАЮТ. ДЕЙСТВУЙ БЫСТРО — ИХ СЛИШКОМ МНОГО.":[[47,"m47_03"]],"ХОЛОДНОЕ ХРАНИЛИЩЕ NEXA. ВНУТРИ — ОБРАЗЦЫ. ТИХО ВОЙТИ, ТИХО ВЫЙТИ.":[[47,"m47_04"]],"БЛОКИРОВКА! ВЗОРВИ СТЕНУ ЗА ХРАНИЛИЩЕМ — ТАМ ТОННЕЛЬ К ГРУЗОВИКУ.":[[47,"m47_05"]],"ТЕБЯ ЗАСЕКЛИ! ОНИ ИДУТ К ТЕБЕ — ПЕРЕКЛЮЧИСЬ НА ОСНОВНОЕ ОРУЖИЕ.":[[0,"gen_01"]],"ПРЕСС ЗА СПИНОЙ! НЕ ОСТАНАВЛИВАЙСЯ!":[[0,"gen_02"]],"ДЕРЖИСЬ РЯДОМ. ОНИ УЖЕ ИДУТ.":[[0,"gen_03"]],"ЭТО ОН. БЕЙ ПО ГОЛОВЕ — БРОНЯ ДЕРЖИТ ПУЛИ.":[[0,"gen_04"]],"ЗАРЯДЫ УСТАНОВЛЕНЫ. УХОДИ — ВЗРЫВ ЧЕРЕЗ 16 СЕКУНД.":[[0,"gen_05"]],"ЗАРЯДЫ УСТАНОВЛЕНЫ. УХОДИ — ВЗРЫВ ЧЕРЕЗ 18 СЕКУНД.":[[0,"gen_06"]]}}
