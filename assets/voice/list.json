ОХРАНИТЕЛЯ.":[[11,"m11_01"]],"ПИТАНИЕ ОТКЛЮЧЕНО. НАЙДИТЕ ТРИ ПРЕДОХРАНИТЕЛЯ.":[[11,"m11_02"]],"ОНО ДВИЖЕТСЯ, КОГДА ВЫ НЕ СМОТРИТЕ.":[[11,"m11_03"]],"ЧАСТИЧНОЕ ПИТАНИЕ. СЛЕДУЮЩИЙ ПРЕДОХРАНИТЕЛЬ.":[[11,"m11_04"]],"ПИТАНИЕ ВОССТАНОВЛЕНО. ОХРАНА ПЕРЕБРАСЫВАЕТСЯ.":[[11,"m11_05"]],"СОСТАВ 12. ПЕРЕВОЗКА СУБЪЕКТА 083. ПОСТОРОННИХ НЕТ.":[[12,"m12_01"]],"ПОЕЗД ОСТАНОВЛЕН.":[[12,"m12_02"]],"ПОЕЗД 083. НОЧНОЙ РЕЙС. ПРОБЕЙТЕСЬ К ЛОКОМОТИВУ.":[[12,"m12_03"]],"ТУННЕЛЬ. ОСВЕЩЕНИЕ ОТКЛЮЧЕНО.":[[12,"m12_04"]],"ОНИ ВРЫВАЮТСЯ ЧЕРЕЗ ОКНА.":[[12,"m12_05"]],"ВНИМАНИЕ. АРЕНА ОТКРЫТА. СУБЪЕКТ 083 ВЫХОДИТ НА ПЛОЩАДКУ.":[[13,"m13_01"]],"ДОБРО ПОЖАЛОВАТЬ НА АРЕНУ. ПЯТЬ РАУНДОВ. ВЫЖИВИТЕ.":[[13,"m13_02"]],"ФИНАЛЬНЫЙ РАУНД. ВЫХОДИТ СМОТРИТЕЛЬ.":[[13,"m13_03"]],"СМОТРИТЕЛЬ ПАЛ. АРЕНА ЗАКРЫТА.":[[13,"m13_04"]],"ПЯТЬ КОМНАТ. ЗАЧИСТИТЬ БЫСТРО. ЗАЛОЖНИКОВ НЕ ТРОГАТЬ.":[[14,"m14_01"]],"ЗАЛОЖНИКИ В БЛОКЕ D. БЕЛЫЙ ЖИЛЕТ — НЕ СТРЕЛЯТЬ.":[[14,"m14_02"]],"КОНТАКТ В КОРИДОРЕ.":[[14,"m14_03"]],"ТЕРМИНАЛ ДОСТУПА — В ГЛУБИНЕ БЛОКА. ОХРАНА НА ОБХОДЕ.":[[15,"m15_01"]],"ОХРАНА НА ОБХОДЕ. ГЛУШИТЕЛЬ УСТАНОВЛЕН. НЕ ПОПАДАЙТЕСЬ НА ГЛАЗА.":[[15,"m15_02"]],"ДАННЫЕ СКОПИРОВАНЫ. ТРЕВОГА. К ВЫХОДУ.":[[15,"m15_03"]],"ВСЕ ПОДСИСТЕМЫ ОТКЛЮЧЕНЫ. ПРОТОКОЛ NEXA АКТИВЕН.":[[16,"m16_01"]],"ПРОТОКОЛ ЗАВЕРШЁН. ОСТАЛСЯ ОДИН СУБЪЕКТ.":[[16,"m16_02"]],"СУБЪЕКТ 084. УСТРАНИТЕ ЕГО — И ЭКСПЕРИМЕНТ ОКОНЧЕН.":[[16,"m16_03"]],"ВЫ ВЫПОЛНИЛИ ПРОТОКОЛ. СУБЪЕКТ 083 ПРИНЯТ.":[[16,"m16_04"]],"ОШИБКА. СУБЪЕКТ 083 НЕ ВЫПОЛНИЛ ПРОТОКОЛ.":[[16,"m16_05"]],"ЭТО... НОВЫЙ РЕЗУЛЬТАТ.":[[16,"m16_06"]],"СУБЪЕКТ 083. ВЫ ПРОШЛИ ВСЕ ТЕСТЫ. ОСТАЛСЯ ПРОТОКОЛ.":[[16,"m16_07"]],"ДОБРО ПОЖАЛОВАТЬ НАВЕРХ. ТРИ ДИСКА НАШЕГО ПРОЕКТА ВЫНЕСЛИ НА ПЛОЩАДЬ. ВЕРНИ ИХ. ПАТРОНЫ ВОЗЬМИ У ЯЩИКОВ.":[[17,"m17_01"]],"ГЕНЕРАТОР ЗАПУЩЕН. ДЕРЖИСЬ — ОНИ УЖЕ ИДУТ.":[[18,"m18_01"]],"УЛИЦА КИШИТ ЛЮДЬМИ ЗАКАЗЧИКА. ПРОЙДИ ТИХО К УБЕЖИЩУ, ЗАПУСТИ ГЕНЕРАТОР И ДЕРЖИСЬ. ЕСЛИ СПАЛЯТ — СТРЕЛЯЙ.":[[18,"m18_02"]],"ОФИС, ГДЕ ЧИСТЯТ СЛЕДЫ. ВЗЛОМАЙ ТЕРМИНАЛ АРХИВА — НО ОХРАНА УСЛЫШИТ ШУМ. ГОТОВЬСЯ.":[[19,"m19_01"]],"ВОРОТА ЗАВАРЕНЫ. C4 ЛЕЖИТ У ЯЩИКОВ. ПОСЛЕ ВЗРЫВА ЗА СПИНОЙ ЗАПУСТЯТ ПРЕСС — НЕ ОСТАНАВЛИВАЙСЯ.":[[20,"m20_01"]],"ПЕРВОЕ НАСТОЯЩЕЕ ДЕЛО. СКЛАД В ПОРТУ. ВЗЛОМАЙ ПАНЕЛЬ, ДОСТАНЬ СПИСОК ГРУЗОВ И УХОДИ. ТИХО, ЕСЛИ ПОЛУЧИТСЯ.":[[21,"m21_01"]],"ТРИ ЗАМКА, ТРИ ЭТАЖА ОХРАНЫ. КАЖДЫЙ ЗАМОК — ВЗЛОМ. ПОЛКОВНИК ЗАПЛАТИЛ ЗА ТИШИНУ.":[[22,"m22_01"]],"КАМЕРЫ ВИДЯТ ВСЁ. НА КАЖДОМ ЭТАЖЕ ЕСТЬ ПАНЕЛЬ, КОТОРАЯ ПУСКАЕТ ИХ ПО КРУГУ. НАЙДИ ЕЁ РАНЬШЕ, ЧЕМ ОНИ НАЙДУТ ТЕБЯ.":[[23,"m23_01"]],"ЧЕТЫРЕ ТАЙНИКА ПО СТАНЦИИ. СОБЕРИ ВСЕ. НА ПЕРРОНЕ ТЕБЯ ЖДУТ ПЕРЕКУПЩИКИ.":[[24,"m24_01"]],"ПАРКОВКА, МАШИНЫ, ТЕНИ. НА УРОВНЕ ТРИ ЧЕЛОВЕКА С КЛЮЧАМИ. ЗАБЕРИ ИХ И ВЫЙДИ ЧЕРЕЗ ЛЮК.":[[25,"m25_01"]],"НАМ НУЖЕН ТЕЛЕФОН ИХ ГЛАВНОГО. ВЗЛОМАЙ ЛИНИЮ, УДЕРЖИВАЙ ЗВОНОК ДВАДЦАТЬ СЕКУНД. НИКТО НЕ ДОЛЖЕН ТЕБЯ ЗАМЕТИТЬ.":[[26,"m26_01"]],"ТРОЕ ЗАЛОЖНИКОВ. ПОСЛЕ ПЕРВОГО ВЫСТРЕЛА ЧАСЫ ИДУТ. ПЕРЕРЕЖЬ ВЕРЁВКИ И ВЫВОДИ ИХ. ЗАЛОЖНИКОВ С БЕЛЫМИ ЖИЛЕТАМИ НЕ ТРОГАЙ.":[[27,"m27_01"]],"СНОСИМ ВСЁ ПО ПЛАНУ. СНАЧАЛА ЗАЧИСТКА, ПОТОМ СТЕНА, ПОТОМ ОСНОВНОЙ ЗАРЯД. У ТЕБЯ ЕСТЬ C4 И ГРАНАТЫ.":[[28,"m28_01"]],"ТРУБЫ ПРОРВАЛО. ГАЗ ПОДНИМАЕТСЯ ВОЛНАМИ — ПРЯЧЬСЯ ЗА УКРЫТИЯМИ. ЗАКРОЙ ВЕНТИЛЬ И УХОДИ.":[[29,"m29_01"]],"ПУСТЬ ОНИ БЕГУТ К ВЗРЫВУ. ЗАЛОЖИ ЗАРЯД ДАЛЕКО ОТ ЦЕЛИ, А САМ ИДИ ТИХО ПО КОРИДОРУ. ДРОБОВИК — НА ЯЩИКЕ.":[[30,"m30_01"]],"КОЛОННА ИДЁТ ЧЕРЕЗ ПОСТ. ЗАЧИСТИ ПОСТ, ВЗОРВИ ГРУЗОВИК И ЗАБЕРИ КОНТЕЙНЕР. ТЯЖЁЛАЯ ПЕХОТА ЖДЁТ ПОД ПРИКРЫТИЕМ.":[[31,"m31_01"]],"ТЯЖЁЛЫЕ ВНУТРИ — ОНИ ПРОБЬЮТ ТЕБЯ НАСКВОЗЬ. БРОСАЙ СВЕТОШУМОВЫЕ И БЕЙ В ГОЛОВУ. ДРОБОВИК ПОМОЖЕТ.":[[32,"m32_01"]],"ТОЛПА ЖДЁТ ШОУ. БОЧКИ НА ПОЛЕ ВЗРЫВАЮТСЯ ОТ ЛЮБОЙ ПУЛИ. ВЫЖИВИ — И МЫ ЗАБИРАЕМ ПРИЗ.":[[33,"m33_01"]],"СВЕТ ВЫКЛЮЧЕН — ФОНАРЬ ЕСТЬ, НО ОХРАНА СЛЫШИТ ШАГИ. ТИХО ДО ТЕРМИНАЛА, ПОТОМ ВЗЛОМ.":[[34,"m34_01"]],"ДОМ ИЗ СТЕКЛА, ЛУЧИ ПОВСЮДУ, КАМЕРЫ НАД ПОТОЛКОМ. ДВИГАЙСЯ МЕДЛЕННО И ЖДИ ПРОМЕЖУТКОВ МЕЖДУ ВСПЫШКАМИ.":[[35,"m35_01"]],"В ХРАНИЛИЩЕ НЕ ХВАТАЕТ ЧЕТЫРЁХ СТРАНИЦ ДОСЬЕ. БИБЛИОТЕКАРЬ ХРАНИТ ИХ В СТЕЛЛАЖАХ. СОБЕРИ ВСЁ И ВЫХОДИ.":[[36,"m36_01"]],"ПРИЗРАК. ОДНА ТРЕВОГА — И ВСЁ СНАЧАЛА. ЗАМЕТЯТ — ПРОВАЛ. ДВИГАЙСЯ ЛЕГКО И ЖДИ ПРОМЕЖУТКОВ МЕЖДУ ВСПЫШКАМИ.":[[37,"m37_01"]],"ТЕБЕ ВЫДАЮТ ВИНТОВКУ. ПКМ — ПРИЦЕЛ, ВЫСТРЕЛ В ГОЛОВУ — ОДИН ПАТРОН. ПОСЛЕ ВЫСТРЕЛА ОСТАЛЬНЫЕ ПОБЕГУТ К ТЕБЕ — ПЕРЕКЛЮЧИСЬ НА АВТОМАТ.":[[38,"m38_01"]],"ТЯЖЁЛАЯ ПЕХОТА. ПУЛИ В ТУЛОВИЩЕ ОНИ ПОЧТИ НЕ ЧУВСТВУЮТ. ЦЕЛЬСЯ В ГОЛОВУ ИЛИ БЕРИ ДРОБОВИК.":[[39,"m39_01"]],"МОСТ УЗКИЙ, УКРЫТИЙ ПОЧТИ НЕТ. МАШИНЫ ПЕРЕКРЫЛИ ПОЛОСЫ. ИДИ ВПЕРЁД, СТРЕЛЯЙ ИЗ-ЗА КАПОТОВ.":[[40,"m40_01"]],"ДВЕ МИНУТЫ ДО ОТПРАВЛЕНИЯ. РАШЕРЫ ВЫХОДЯТ ИЗ ВАГОНОВ ПО ОДНОМУ И ПО ТРОЕ. НЕ ЖДИ — ИДИ ВПЕРЁД.":[[41,"m41_01"]],"ОНИ ИДУТ ВОЛНАМИ. ГЕНЕРАТОРЫ ДАЮТ СВЕТ И ДВЕРИ. ЗАПУСКАЙ КАЖДЫЙ И ДЕРЖИСЬ, ПОКА ПОЛНОСТЬЮ НЕ ЗАГРУЗИТСЯ.":[[42,"m42_01"]],"ЭТО ОН. БРОНЯ ДЕРЖИТ ПУЛИ — ЦЕЛЬСЯ В ГОЛОВУ.":[[43,"m43_01"]],"ЭТО ТОТ, КТО ПРОДАЛ ТЕБЯ. ТИХО ДО ЕГО КОМНАТЫ, ПОТОМ БОЙ. ОН В БРОНЕ — ЦЕЛЬСЯ В ГОЛОВУ.":[[43,"m43_02"]],"СМОТРИТЕЛЬ ВЕРНУЛСЯ. ЭТО ВТОРОЙ РАЗ, КОГДА ТЫ ВСТРЕЧАЕШЬСЯ С НИМ. ЗДЕСЬ БОЧЕК НЕТ, ЗАТО ЕСТЬ ГРАНАТЫ.":[[44,"m44_01"]],"ПЛАНЫ ХРАНИЛИЩА ЛЕЖАТ У АРХИТЕКТОРА. ТИХО, ВЗЛОМ, ПОТОМ ЧЕТЫРЕ ЛИСТА — И БЕГОМ ВНИЗ.":[[45,"m45_01"]],"ПОСЛЕДНЯЯ РЕПЕТИЦИЯ ПЕРЕД НАСТОЯЩИМ ДЕЛОМ. ТИХО ДО СЕЙФА, ВЗРЫВ СТЕНЫ, ГРАБЁЖ И ЗАБЕГ ПОД ТАЙМЕРОМ.":[[46,"m46_01"]],"НА ХРАНЕНИИ — ОБРАЗЦЫ NEXA. ТИХО ВОЙТИ. ТИХО ВЫЙТИ. ЕСЛИ ЗАМЕТЯТ — БЕГИ.":[[47,"m47_01"]],"СИГНАЛИЗАЦИЯ. ПРОБИВАЙСЯ К ВЫХОДУ.":[[47,"m47_02"]],"ОНИ ВСЁ ЗНАЮТ. ДЕЙСТВУЙ БЫСТРО — ИХ СЛИШКОМ МНОГО.":[[47,"m47_03"]],"ХОЛОДНОЕ ХРАНИЛИЩЕ NEXA. ВНУТРИ — ОБРАЗЦЫ. ТИХО ВОЙТИ, ТИХО ВЫЙТИ.":[[47,"m47_04"]],"БЛОКИРОВКА! ВЗОРВИ СТЕНУ ЗА ХРАНИЛИЩЕМ — ТАМ ТОННЕЛЬ К ГРУЗОВИКУ.":[[47,"m47_05"]],"ТЕБЯ ЗАСЕКЛИ! ОНИ ИДУТ К ТЕБЕ — ПЕРЕКЛЮЧИСЬ НА ОСНОВНОЕ ОРУЖИЕ.":[[0,"gen_01"]],"ПРЕСС ЗА СПИНОЙ! НЕ ОСТАНАВЛИВАЙСЯ!":[[0,"gen_02"]],"ДЕРЖИСЬ РЯДОМ. ОНИ УЖЕ ИДУТ.":[[0,"gen_03"]],"ЭТО ОН. БЕЙ ПО ГОЛОВЕ — БРОНЯ ДЕРЖИТ ПУЛИ.":[[0,"gen_04"]],"ЗАРЯДЫ УСТАНОВЛЕНЫ. УХОДИ — ВЗРЫВ ЧЕРЕЗ 16 СЕКУНД.":[[0,"gen_05"]],"ЗАРЯДЫ УСТАНОВЛЕНЫ. УХОДИ — ВЗРЫВ ЧЕРЕЗ 18 СЕКУНД.":[[0,"gen_06"]]},"en":{"Sleep tight, 083.":[[48,"D48_001"]],"Wake up, 083.":[[48,"D48_002"]],"This is me – Dictor.":[[48,"D48_003"]],"You are probably wondering where you are. You are exactly where you need to be.":[[48,"D48_004"]],"Out there is a complex. NEXA Industries. Three floors, one vault, and more guards than you can count.":[[48,"D48_005"]],"Everything they ever did is written down in that vault. Every name. Every price.":[[48,"D48_006"]],"So tonight we walk in through the front door.":[[48,"D48_007"]],"We make that whole place afraid. Every hall. Every room. Every person inside.":[[48,"D48_008"]],"And you are going to need something heavier than a pistol.":[[48,"D48_009"]],"Forty kilos. In the suit it weighs nothing. Almost nothing.":[[48,"D48_010"]],"Take it. It is yours.":[[48,"D48_011"]],"Now sleep. We have a long drive ahead.":[[48,"D48_012"]],"Put him back to sleep.":[[48,"D48_013"]],"Wake up, 083. You slept through the whole city.":[[48,"D48_014"]],"Do not mind the driving. I like to arrive before I leave.":[[48,"D48_015"]],"Tonight you are not a man. You are a message.":[[48,"D48_016"]],"NEXA believes it owns every door in this town.":[[48,"D48_017"]],"Tonight we open all of them.":[[48,"D48_018"]],"Red light? Red is a colour for people who have time.":[[48,"D48_019"]],"Rule one: nobody leaves that building calm.":[[48,"D48_020"]],"Not the guards. Not the clerks. Not the cleaning ladies.":[[48,"D48_021"]],"Rule two: they remember us. Every face. Every name.":[[48,"D48_022"]],"Listen to the tunnel, 083. It loves the bass.":[[48,"D48_023"]],"Look at them. Hundreds of people driving home, believing tomorrow is a promise.":[[48,"D48_024"]],"We are going to punish them. Slowly. And then all at once.":[[48,"D48_025"]],"And whatever you hear in there...":[[48,"D48_026"]],"Whatever they scream at you...":[[48,"D48_027"]],"Remember.":[[48,"D48_028"]],"There it is. NEXA Industries.":[[48,"D48_029"]],"Three floors up. Three down. A vault in the sky.":[[48,"D48_030"]],"And a man in the basement who owes us an answer.":[[48,"D48_031"]],"Belt on, 083. Last turn.":[[48,"D48_032"]],"Not a word of Russian. Not one.":[[48,"D48_033"]],"Welcome to NEXA Industries, 083.":[[48,"D48_034"]],"Three floors above us. One vault. And more guards than you can count.":[[48,"D48_035"]],"Staff door, north wall. Two guards. One walks the containers, one holds the door.":[[48,"D48_036"]],"No guns. Hands only. Quietly.":[[48,"D48_037"]],"Break their necks. The moment someone shouts, we are finished.":[[48,"D48_038"]],"Cover blown. Finish them!":[[48,"D48_039"]],"Clean. Inside.":[[48,"D48_040"]],"Level B0. The armoury is on the left. Go.":[[48,"D48_041"]],"Heavy assault suits. Eight hundred kilos of armour and hydraulics between the three of us.":[[48,"D48_042"]],"Walk slow. It will feel like wading through water. Nothing gets through that plating.":[[48,"D48_043"]],"Remember!":[[48,"D48_044"]],"Not a word of Russian.":[[48,"D48_045"]],"When these doors open, there is no way back.":[[48,"D48_046"]],"Ten counters. Hundreds of civilians. Keep walking and keep firing.":[[48,"D48_047"]],"Floor one. Ten counters. Three hundred witnesses.":[[48,"D48_048"]],"Walk through them. Nothing in this building can hurt you.":[[48,"D48_049"]],"Alarm is up. Good. Let them come to us.":[[48,"D48_050"]],"Guards at the gates. Cut them down.":[[48,"D48_051"]],"Do not stop. Fire at everything that moves.":[[48,"D48_052"]],"More of them from the north corridors. Hold the centre.":[[48,"D48_053"]],"Keep firing. The stairs unlock when the floor is clear.":[[48,"D48_054"]],"Security is pulling everything it has. Let them.":[[48,"D48_055"]],"Almost there. Do not let up.":[[48,"D48_056"]],"Stairs are open. Go! Go!":[[48,"D48_057"]],"Level two. Vault and archive.":[[48,"D48_058"]],"Security sealed every wing.":[[48,"D48_059"]],"A shutter releases when its wing is clear.":[[48,"D48_060"]],"So clear it.":[[48,"D48_061"]],"South wing is breaking. Keep the pressure.":[[48,"D48_062"]],"They are pulling guards from every floor.":[[48,"D48_063"]],"Central wing is folding. Stay on them.":[[48,"D48_064"]],"Last wing. The gate is right behind them.":[[48,"D48_065"]],"Almost through. Do not let up.":[[48,"D48_066"]],"The gate is sealed. We blow it.":[[48,"D48_067"]],"Blast doors. Forty centimetres of steel.":[[48,"D48_068"]],"Charge is set. Everybody back!":[[48,"D48_069"]],"Vault is open. Two minutes. Take everything.":[[48,"D48_070"]],"Lockdown! We are out of time!":[[48,"D48_071"]],"Keep moving. Every bar counts.":[[48,"D48_072"]],"One minute!":[[48,"D48_073"]],"Twenty seconds. Grab what you can reach!":[[48,"D48_074"]],"That is all of it. Now go!":[[48,"D48_075"]],"Warning. Lethal gas release on level two. All personnel evacuate.":[[48,"D48_076"]],"Gas! They are venting the whole floor!":[[48,"D48_077"]],"South. The stairs. Run!":[[48,"D48_078"]],"It is moving. Stay ahead of it!":[[48,"D48_079"]],"Gas is right behind us! Keep running!":[[48,"D48_080"]],"Cut through them. Do not stop to fight.":[[48,"D48_081"]],"The stairs! Straight ahead!":[[48,"D48_082"]],"Alarm is up on every floor. Straight to the lift.":[[48,"D48_083"]],"Do not stop. The lift is at the far end.":[[48,"D48_084"]],"Almost there. Cut them down!":[[48,"D48_085"]],"Sublevel four. The man we came for is down there.":[[48,"D48_086"]],"Last ride, gentlemen.":[[48,"D48_087"]],"Security. Of course.":[[48,"D48_088"]],"Six locks. One door. Walk through everything in your way.":[[48,"D48_089"]],"Hold the corridor. The lock opens when the section is clear.":[[48,"D48_090"]],"They keep coming from the rooms. Good.":[[48,"D48_091"]],"Second lock. Same rules.":[[48,"D48_092"]],"Barricades ahead. Walk through them.":[[48,"D48_093"]],"They are bringing everything down from the surface.":[[48,"D48_094"]],"Behind us too! Keep moving!":[[48,"D48_095"]],"Red lights. Security protocol three. They are afraid.":[[48,"D48_096"]],"Good. Let them come.":[[48,"D48_097"]],"Lights are failing. Keep firing.":[[48,"D48_098"]],"One more lock after this one.":[[48,"D48_099"]],"Final lock! Break it and the door is ours.":[[48,"D48_100"]],"Everything they have left is here. Finish it!":[[48,"D48_101"]],"Final lock released!":[[48,"D48_102"]],"Lock released. Go!":[[48,"D48_103"]],"The antechamber. Last of them.":[[48,"D48_104"]],"That is the door. Number zero eight three.":[[48,"D48_105"]],"Hey. Hey! Look at me.":[[48,"D48_106"]],"Where is he?":[[48,"D48_107"]],"Where is the one who did this to you?":[[48,"D48_108"]],"Wake up!":[[48,"D48_109"]],"That bastard let animal gas in on us.":[[48,"D48_110"]],"We were all knocked out cold.":[[48,"D48_111"]],"Get up.":[[48,"D48_112"]],"GET UP!":[[48,"D48_113"]],"There he is.":[[48,"D48_114"]],"Your call, 083.":[[48,"D48_115"]],"Pick it up, 083.":[[48,"D48_116"]],"Then I will.":[[48,"D48_117"]],"Everything NEXA gave us stays here.":[[48,"D48_118"]],"No suits. No names. Nothing left to follow.":[[48,"D48_119"]],"Six charges. Three floors. One button.":[[48,"D48_120"]],"Do it, 083.":[[48,"D48_121"]],"Floor three. One charge each side of the desk.":[[48,"D48_122"]],"Armed. That tripped the alarm. Here they come!":[[48,"D48_123"]],"Both set. Down to the vault level.":[[48,"D48_124"]],"The vault level. Charges on the pillars. They carry the whole floor.":[[48,"D48_125"]],"Armed. Guards are pouring out of the vault rooms!":[[48,"D48_126"]],"Both set. One floor left. The main hall.":[[48,"D48_127"]],"The main hall. Two on the columns. Then we walk out the front door.":[[48,"D48_128"]],"Armed. The whole building is coming. Hold the line!":[[48,"D48_129"]],"Six charges. Everyone out. Now.":[[48,"D48_130"]]},"fx":{"D48_001":"muffle","D48_076":"radio"}}
